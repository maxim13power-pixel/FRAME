# ============================================================
# FRAME backend — переменные окружения (ПЛЕЙСХОЛДЕРЫ!)
# Скопируй в backend/.env и заполни реальными значениями.
# НИКОГДА не коммить backend/.env — он в .gitignore.
# ============================================================

# --- База данных (Prisma) ---
# Строка подключения к PostgreSQL. Пользователь/пароль совпадают с docker-compose.yml.
DATABASE_URL=postgresql://frame_user:frame_pass@localhost:5433/frame_db?schema=public

# --- Auth ---
# Секрет подписи JWT-токенов. Любая длинная случайная строка.
JWT_SECRET=your-secret-key-here

# --- CORS / фронт ---
# Разрешённые origin фронта (через запятую, если несколько).
CORS_ORIGINS=http://localhost:5000
# Публичный URL фронта — подставляется в ссылки восстановления пароля.
FRONTEND_URL=http://localhost:5000

# --- Yandex SmartCaptcha ---
# Серверный ключ капчи (проверка токена на бэке, captcha.service.ts).
SMARTCAPTCHA_SERVER_KEY=your-smartcaptcha-server-key

# --- SMTP (письма: код подтверждения, восстановление пароля — email.service.ts) ---
# №209: прод на Amvera использует Яндекс 360 (Brevo из РФ не работает).
# Яндекс: хост smtp.yandex.ru, порт 465 (SSL) или 587 (STARTTLS), логин = полный ящик,
# пароль — «пароль приложения» из Яндекс ID (обычный пароль не подойдёт).
# ВАЖНО: без SMTP регистрация в prod невозможна (код уходит только письмом,
# devCode отдаётся лишь вне production).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=robot@frame-app.ru
SMTP_PASS=your-yandex-app-password
# Адрес отправителя: у Яндекса должен совпадать с SMTP_USER (иначе письмо отклонится).
SMTP_FROM=robot@frame-app.ru

# Устаревший алиас (Brevo) — поддерживается, если SMTP_* не заданы.
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=
# BREVO_SMTP_PASS=
# BREVO_FROM_EMAIL=
