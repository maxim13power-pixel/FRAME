// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
 }

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  phone     String   @unique
  password  String
  fullName  String
  role      Role     @default(FOREMAN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Object {
  id          Int      @id @default(autoincrement())
  name        String
  address     String
  startDate   DateTime
  endDate     DateTime
  plannedEndDate  DateTime?  // ← ДОБАВИТЬ: первоначальная плановая дата
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projects    Project[]
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  startDate   DateTime
  endDate     DateTime
  objectId    Int
  object      Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  materials   Material[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // TODO: таблица работ/материалов будет привязана к проекту
}

enum Role {
  ADMIN
  STORE_MANAGER
  FOREMAN
  CUSTOMER
}

enum Unit {
  PIECE          // шт
  METER          // м
  SQUARE_METER   // м²
  CUBIC_METER    // м³
  KILOGRAM       // кг
  LITER          // л
  TON            // т
  BAG            // мешок
  PACKAGE        // упаковка
  SET            // комплект
}

model Material {
  id              Int            @id @default(autoincrement())
  name            String
  article         String?
  unit            Unit           @default(PIECE)
  specQuantity    Float          // количество по спецификации (план)
  totalUsed       Float          @default(0)  // фактический расход (автосчёт)
  lastEntry       Float?         // последняя фиксация
  lastEntryDate   DateTime?      // дата последней фиксации
  note            String?
  progressPercent Float          @default(0)  // % выполнения
  isSpecLocked    Boolean        @default(true) // защита спецификации
  
  // Работы (из справочника "Цены на работы")
  priceItemId     Int?
  priceItem       PriceItem?     @relation("WorkPrice", fields: [priceItemId], references: [id], onDelete: SetNull)
  unitPrice       Float          @default(0)  // SNAPSHOT цены работы
  totalCost       Float          @default(0)  // totalUsed × unitPrice (работы на тек. момент)
  
  // Материалы (из справочника "Цены на материалы")
  materialItemId  Int?
  materialItem    PriceItem?     @relation("MaterialPrice", fields: [materialItemId], references: [id], onDelete: SetNull)
  materialUnitPrice Float        @default(0)  // SNAPSHOT цены материала
  materialTotalCost Float        @default(0)  // totalUsed × materialUnitPrice (материалы на тек. момент)
  
  projectId       Int
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fixes           MaterialFix[]  // история всех фиксаций
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  @@map("materials")
}

model MaterialFix {
  id          Int       @id @default(autoincrement())
  materialId  Int
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  amount      Float     // объём этой фиксации
  note        String?   // примечание к фиксации
  fixedAt     DateTime  @default(now())  // когда зафиксировано
  userId      Int?      // кто зафиксировал (опционально, пока оставим)

  @@map("material_fixes")
}

model PriceCategory {
  id        Int         @id @default(autoincrement())
  name      String      @unique  // "Электрика", "Отделка"
  sortOrder Int         @default(0)
  items     PriceItem[]

  @@map("price_categories")
}

model PriceItem {
  id         Int           @id @default(autoincrement())
  name       String        // "Установка розетки"
  article    String?
  unit       Unit          @default(PIECE)
  price      Float         @default(0)
  categoryId Int
  category   PriceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isActive   Boolean       @default(true)
  
  // Связи: работа или материал
  workMaterials     Material[]  @relation("WorkPrice")
  materialMaterials Material[]  @relation("MaterialPrice")
  
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  @@map("price_items")
}