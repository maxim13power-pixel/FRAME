// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int             @id @default(autoincrement())
  email       String?          @unique
  phone       String?          @unique
  password    String
  fullName    String
  role        Role            @default(FOREMAN)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Новые связи вместо Organization
  objectAccesses    ObjectAccess[]
  proposedChanges   ChangeRequest[]  @relation("ProposedChanges")
  reviewedChanges   ChangeRequest[]  @relation("ReviewedChanges")
  ownedPriceItems   PriceItem[]
  createdInvites    InviteToken[]  @relation("CreatedInvites")
  passwordResetTokens PasswordResetToken[]  // ⭐ P0-4
  rentals           Rental[]  // ⭐ личные аренды оборудования пользователя
}

model Object {
  id              Int           @id @default(autoincrement())
  name            String
  address         String
  startDate       DateTime
  endDate         DateTime
  plannedEndDate  DateTime?     // первоначальная плановая дата
  isArchived      Boolean       @default(false) // Архив вместо удаления (P3)
  isDemo          Boolean       @default(false) // ⭐ демо-объект для онбординга (№127)
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  projects        Project[]
  accesses        ObjectAccess[] // Кто имеет доступ к объекту
  inviteTokens    InviteToken[]  // Активные ссылки-приглашения
  warehouseItems  WarehouseItem[] // ⭐ Складские позиции, привязанные к объекту
  reports         Report[]        // ⭐ Акты/сметы по объекту
  brigades        Brigade[]       // ⭐ Бригады, привязанные к объекту
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  startDate   DateTime
  endDate     DateTime
  objectId    Int
  object      Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  materials   Material[]
  changeRequests ChangeRequest[] // Согласования на уровне проекта
  warehouseTransactions WarehouseTransaction[] // ⭐ Складские списания на проект
  reports     Report[] // ⭐ Акты/сметы по проекту
  brigadeShifts BrigadeShift[] // ⭐ Выходы бригад на проекте
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  note        String?

  @@index([endDate])
  @@index([objectId])
}

enum Role {
  ADMIN
  STORE_MANAGER
  FOREMAN
  CUSTOMER
}

enum PriceKind {
  WORK      // работы
  MATERIAL  // материалы
}

enum Unit {
  PIECE          // шт
  METER          // м
  SQUARE_METER   // м²
  CUBIC_METER    // м³
  KILOGRAM       // кг
  LITER          // л
  TON            // т
  BAG            // мешок
  PACKAGE        // упаковка
  SET            // комплект
}

model Material {
  id              Int            @id @default(autoincrement())
  name            String
  article         String?
  unit            Unit           @default(PIECE)
  specQuantity    Decimal        @db.Decimal(14, 3) // количество по спецификации (план)
  totalUsed       Decimal        @default(0) @db.Decimal(14, 3) // фактический расход (автосчёт)
  lastEntry       Decimal?       @db.Decimal(14, 3) // последняя фиксация
  lastEntryDate   DateTime?      // дата последней фиксации
  note            String?
  progressPercent Float          @default(0)  // % выполнения (процент — не деньги/объём, остаётся Float)
  isSpecLocked    Boolean        @default(true) // защита спецификации

  // Работы (из справочника "Цены на работы")
  priceItemId     Int?
  priceItem       PriceItem?     @relation("WorkPrice", fields: [priceItemId], references: [id], onDelete: SetNull)
  unitPrice       Decimal        @default(0) @db.Decimal(14, 2) // SNAPSHOT цены работы
  totalCost       Decimal        @default(0) @db.Decimal(14, 2) // totalUsed × unitPrice (работы на тек. момент)

  // Материалы (из справочника "Цены на материалы")
  materialItemId  Int?
  materialItem    PriceItem?     @relation("MaterialPrice", fields: [materialItemId], references: [id], onDelete: SetNull)
  materialUnitPrice Decimal      @default(0) @db.Decimal(14, 2) // SNAPSHOT цены материала
  materialTotalCost Decimal      @default(0) @db.Decimal(14, 2) // totalUsed × materialUnitPrice (материалы на тек. момент)

  projectId       Int
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fixes           MaterialFix[]  // история всех фиксаций
  changeRequests  ChangeRequest[] // Согласования по конкретному материалу
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId])
  @@map("materials")
}

model MaterialFix {
  id          Int       @id @default(autoincrement())
  materialId  Int
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(14, 3) // объём этой фиксации
  note        String?   // примечание к фиксации
  fixedAt     DateTime  @default(now())  // когда зафиксировано
  userId      Int?      // кто зафиксировал
  isEdited    Boolean   @default(false)
  editedAt    DateTime?

  @@index([fixedAt])
  @@index([materialId, fixedAt])
  @@map("material_fixes")
}

model PriceCategory {
  id        Int           @id @default(autoincrement())
  name      String
  sortOrder Int           @default(0)
  kind      PriceKind     @default(WORK)
  items     PriceItem[]

  @@unique([name, kind])
  @@map("price_categories")
}

model PriceItem {
  id         Int           @id @default(autoincrement())
  ownerId    Int?          // null = общий стартовый справочник, userId = личный приватный (3.7)
  owner      User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name       String
  article    String?
  unit       Unit          @default(PIECE)
  price      Decimal       @default(0) @db.Decimal(14, 2)
  categoryId Int
  category   PriceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isActive   Boolean       @default(true)
  kind       PriceKind     @default(WORK)

  // Связи: работа или материал
  workMaterials     Material[]  @relation("WorkPrice")
  materialMaterials Material[]  @relation("MaterialPrice")
  reportItems       ReportItem[] // ⭐ Позиции в отчётах (смета/акт)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([categoryId, ownerId])
  @@map("price_items")
}

// ============================================================
// НОВАЯ МОДЕЛЬ ДОСТУПА И СОГЛАСОВАНИЙ (Вместо Organization)
// ============================================================

enum AccessRole {
  CUSTOMER // Заказчик — утверждает, видит всё, платит
  FOREMAN  // Прораб — добавляет/фиксирует, его изменения на согласовании
  VIEWER   // Наблюдатель — видит прогресс и количества, БЕЗ денег
}

model ObjectAccess {
  id         Int        @id @default(autoincrement())
  userId     Int
  objectId   Int
  projectId  Int?       // null = весь объект, иначе конкретный проект
  role       AccessRole @default(FOREMAN)
  hidePrices Boolean    @default(false)  // ⭐ скрывать ли цены для этого участника
  invitedBy  Int?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  object     Object     @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  @@unique([userId, objectId, projectId])
  @@index([objectId])
  @@map("object_access")
}

enum ChangeStatus {
  PENDING  // Ждет согласования (розовая идея)
  APPROVED // Утверждено (входит в сумму)
  REJECTED // Отклонено (не входит в сумму, но строка видна прорабу)
}

model ChangeRequest {
  id          Int          @id @default(autoincrement())
  projectId   Int
  materialId  Int?
  type        String       // ADD_ROW / CHANGE_QTY / CHANGE_PRICE
  payload     Json         // Контекст изменения
  status      ChangeStatus @default(PENDING)
  proposedBy  Int          // прораб
  reviewedBy  Int?         // заказчик
  reviewComment String?    // ⭐ P0-6: комментарий ревьюера (причина отклонения)
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material    Material?    @relation(fields: [materialId], references: [id], onDelete: SetNull)
  proposer    User         @relation("ProposedChanges", fields: [proposedBy], references: [id], onDelete: Cascade)
  reviewer    User?        @relation("ReviewedChanges", fields: [reviewedBy], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId, createdAt])
  @@map("change_requests")
}

// ============================================================
// ПРИГЛАШЕНИЯ ССЫЛКОЙ (как в Notion/Figma)
// ============================================================

model InviteToken {
  id         Int          @id @default(autoincrement())
  token      String       @unique           // URL-safe токен (nanoid)
  objectId   Int
  createdBy  Int          // кто создал ссылку (прораб или заказчик)
  role       AccessRole   @default(FOREMAN) // роль, с которой будет добавлен юзер
  hidePrices Boolean      @default(false)   // ⭐ флаг «скрыть цены» для приглашённых
  expiresAt  DateTime?    // срок жизни (null = бессрочно)
  maxUses    Int?         // макс. использований (null = без лимита)
  usesCount  Int          @default(0)       // счётчик использований
  isActive   Boolean      @default(true)    // можно отозвать ссылку
  createdAt  DateTime     @default(now())
  object     Object       @relation(fields: [objectId], references: [id], onDelete: Cascade)
  creator    User         @relation("CreatedInvites", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([objectId])
  @@map("invite_tokens")
}

// ============================================================
// ВОССТАНОВЛЕНИЕ ПАРОЛЯ (P0-4)
// ============================================================
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique              // URL-safe токен (crypto.randomBytes)
  expiresAt DateTime                     // срок действия (обычно 1 час)
  usedAt    DateTime?                    // null = не использован, дата = использован
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// АРЕНДА (личный учёт арендованного оборудования)
// ============================================================
model Rental {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String               // что за оборудование
  location    String?              // где лежит (необязательно)
  responsible String?              // кто ответственный (необязательно)
  startDate   DateTime
  endDate     DateTime
  price       Decimal              @db.Decimal(14, 2) // цена аренды при создании
  totalSpent  Decimal              @db.Decimal(14, 2) // всего потрачено (price + все продления)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("rentals")
}

// ============================================================
// СКЛАД (учёт материалов/оборудования прораба)
// ============================================================
model WarehouseItem {
  id          Int       @id @default(autoincrement())
  name        String
  unit        String    @default("шт")
  category    String?   // "инструмент", "расходник", "оборудование"
  quantity    Decimal   @default(0) @db.Decimal(12, 2)
  price       Decimal?  @db.Decimal(12, 2)
  comment     String?
  objectId    Int?      // привязка к объекту (опционально)
  object      Object?   @relation(fields: [objectId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  transactions WarehouseTransaction[]

  @@index([objectId])
  @@map("warehouse_items")
}

model WarehouseTransaction {
  id              Int            @id @default(autoincrement())
  warehouseItemId Int
  warehouseItem   WarehouseItem  @relation(fields: [warehouseItemId], references: [id], onDelete: Cascade)
  type            String         // "income" / "expense" / "write-off"
  quantity        Decimal        @db.Decimal(12, 2)
  price           Decimal?       @db.Decimal(12, 2)
  projectId       Int?           // куда списано (для expense/write-off)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comment         String?
  createdBy       Int
  createdAt       DateTime       @default(now())

  @@index([warehouseItemId])
  @@index([projectId])
  @@map("warehouse_transactions")
}

// ============================================================
// ОТЧЁТЫ (сметы и акты выполненных работ)
// ============================================================
model Report {
  id          Int       @id @default(autoincrement())
  type        String    // "estimate" (смета) / "act" (акт выполненных работ)
  title       String
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  objectId    Int
  object      Object    @relation(fields: [objectId], references: [id], onDelete: Cascade)
  totalAmount Decimal   @db.Decimal(12, 2) @default(0)
  status      String    @default("draft") // "draft" / "sent" / "approved" / "rejected"
  comment     String?
  createdBy   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items       ReportItem[]

  @@index([projectId])
  @@index([objectId])
  @@index([status])
  @@map("reports")
}

model ReportItem {
  id         Int         @id @default(autoincrement())
  reportId   Int
  report     Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  materialId Int?        // ссылка на позицию справочника цен (опционально)
  material   PriceItem?  @relation(fields: [materialId], references: [id], onDelete: SetNull)
  name       String
  unit       String      @default("шт")
  quantity   Decimal     @db.Decimal(12, 2)
  price      Decimal     @db.Decimal(12, 2)
  total      Decimal     @db.Decimal(12, 2)
  sortOrder  Int         @default(0)

  @@index([reportId])
  @@map("report_items")
}

// ============================================================
// ВЕРИФИКАЦИЯ EMAIL ПРИ РЕГИСТРАЦИИ (6-значный код)
// ============================================================
model VerificationToken {
  id        Int      @id @default(autoincrement())
  email     String
  code      String   // 6-значный код
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@map("verification_tokens")
}

// ============================================================
// БРИГАДЫ (учёт выходов и выработки)
// ============================================================
model Brigade {
  id          Int       @id @default(autoincrement())
  name        String    // "Бригада отделочников №1"
  specialty   String?   // "отделочники", "электрики", "сантехники"
  foremanName String?   // бригадир
  phone       String?
  objectId    Int?      // привязка к объекту (опционально — мобильная бригада)
  object      Object?   @relation(fields: [objectId], references: [id], onDelete: SetNull)
  comment     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  members     BrigadeMember[]
  shifts      BrigadeShift[]

  @@index([objectId])
  @@map("brigades")
}

model BrigadeMember {
  id         Int       @id @default(autoincrement())
  brigadeId  Int
  brigade    Brigade   @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  fullName   String
  role       String?   // "бригадир", "мастер", "рабочий"
  phone      String?
  createdAt  DateTime  @default(now())

  @@index([brigadeId])
  @@map("brigade_members")
}

model BrigadeShift {
  id          Int       @id @default(autoincrement())
  brigadeId   Int
  brigade     Brigade   @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  projectId   Int?      // на каком проекте работали
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  date        DateTime  @db.Date
  hoursWorked Decimal   @db.Decimal(5, 2) // 0.00 - 999.99
  outputValue Decimal?  @db.Decimal(12, 2) // выработка в ₽ (опционально)
  outputArea  Decimal?  @db.Decimal(10, 2) // выработка в м² (опционально)
  comment     String?
  createdBy   Int
  createdAt   DateTime  @default(now())

  @@index([brigadeId])
  @@index([projectId])
  @@index([date])
  @@map("brigade_shifts")
}

// ============================================================
// ШАБЛОНЫ СМЕТ (№129) — сохранить проект как шаблон и применить
// ============================================================
model EstimateTemplate {
  id        Int                    @id @default(autoincrement())
  name      String
  ownerId   Int                    // владелец шаблона (userId)
  createdAt DateTime               @default(now())
  items     EstimateTemplateItem[]

  @@index([ownerId])
  @@map("estimate_templates")
}

model EstimateTemplateItem {
  id                Int               @id @default(autoincrement())
  templateId        Int
  template          EstimateTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name              String
  unit              Unit              @default(PIECE)
  quantity          Decimal           @db.Decimal(14, 3) // specQuantity
  unitPrice         Decimal           @db.Decimal(14, 2) // снимок цены работы
  materialUnitPrice Decimal           @db.Decimal(14, 2) // снимок цены материала
  priceItemId       Int?              // ссылка на расценку работы (опционально)
  materialItemId    Int?              // ссылка на расценку материала (опционально)
  sortOrder         Int               @default(0)

  @@index([templateId])
  @@map("estimate_template_items")
}

// ============================================================
// АУДИТ-ЛОГ (№131) — append-only журнал ключевых действий
// ============================================================
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int      // кто совершил (userId)
  entity    String   // "price_item" | "report" | "material_fix" | "object_access"
  entityId  Int
  action    String   // "create" | "update" | "delete" | "status_change" | "price_change"
  before    Json?    // снимок до (опционально)
  after     Json?    // снимок после
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}