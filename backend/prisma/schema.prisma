// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int             @id @default(autoincrement())
  email       String?          @unique
  phone       String?          @unique
  password    String
  fullName    String
  role        Role            @default(FOREMAN)
  // ⭐ №160: версия сессий. Инкремент = «выйти на всех устройствах»:
  // все ранее выданные JWT становятся невалидными (проверка в jwt.strategy.ts).
  tokenVersion Int            @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Новые связи вместо Organization
  objectAccesses    ObjectAccess[]
  ownedPriceItems   PriceItem[]
  priceCatalogs     PriceCatalog[] @relation("CatalogOwner") // ⭐ №151: личные справочники цен
  createdInvites    InviteToken[]  @relation("CreatedInvites")
  passwordResetTokens PasswordResetToken[]  // ⭐ P0-4
  rentals           Rental[]  // ⭐ личные аренды оборудования пользователя
  // ⭐ №178: заявки на право создавать проекты в объекте
  accessRequestsMade     AccessRequest[] @relation("AccessRequestsMade")
  accessRequestsReviewed AccessRequest[] @relation("AccessRequestsReviewed")
  // ⭐ №175: шаблоны объектов
  objectTemplates        ObjectTemplate[] @relation("ObjectTemplates")
  // ⭐ №194 (F1 шаг 2): неизменяемые снимки доступа (создаются при отзыве)
  accessSnapshots        AccessSnapshot[] @relation("AccessSnapshots")
}

model Object {
  id              Int           @id @default(autoincrement())
  name            String
  address         String
  startDate       DateTime
  endDate         DateTime
  plannedEndDate  DateTime?     // первоначальная плановая дата
  isArchived      Boolean       @default(false) // ⚠️ №168: легаси, глобального архива больше нет (сброшено миграцией)
  isDemo          Boolean       @default(false) // ⭐ демо-объект для онбординга (№127)
  note            String?
  // ⭐ №168: кто создал объект. Только метка в карточке — прав не даёт
  // (права определяет ObjectAccess, чтобы не было «второго источника истины»).
  createdById     Int?
  // ⭐ №164: справочник цен объекта — по умолчанию для всех его проектов
  catalogId       Int?
  catalog         PriceCatalog? @relation("ObjectCatalog", fields: [catalogId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  projects        Project[]
  accesses        ObjectAccess[] // Кто имеет доступ к объекту
  inviteTokens    InviteToken[]  // Активные ссылки-приглашения
  warehouseItems  WarehouseItem[] // ⭐ Складские позиции, привязанные к объекту
  reports         Report[]        // ⭐ Акты/сметы по объекту
  brigades        Brigade[]       // ⭐ Бригады, привязанные к объекту
  accessRequests  AccessRequest[] // ⭐ №178: заявки на право создавать проекты

  @@index([catalogId])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  startDate   DateTime
  endDate     DateTime
  objectId    Int
  object      Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  catalogId   Int?     // ⭐ №151: справочник цен проекта (по умолчанию — для подстановки в смете)
  catalog     PriceCatalog? @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  materials   Material[]
  warehouseTransactions WarehouseTransaction[] // ⭐ Складские списания на проект
  reports     Report[] // ⭐ Акты/сметы по проекту
  brigadeShifts BrigadeShift[] // ⭐ Выходы бригад на проекте
  importBatches ImportBatch[] // ⭐ №202: партии импорта сметы из Excel
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  note        String?

  @@index([endDate])
  @@index([objectId])
  @@index([catalogId])
}

enum Role {
  ADMIN
  STORE_MANAGER
  FOREMAN
  CUSTOMER
}

enum PriceKind {
  WORK      // работы
  MATERIAL  // материалы
}

enum Unit {
  PIECE          // шт
  METER          // м
  SQUARE_METER   // м²
  CUBIC_METER    // м³
  KILOGRAM       // кг
  LITER          // л
  TON            // т
  BAG            // мешок
  PACKAGE        // упаковка
  SET            // комплект
}

model Material {
  id              Int            @id @default(autoincrement())
  name            String
  article         String?
  unit            Unit           @default(PIECE)
  specQuantity    Decimal        @db.Decimal(14, 3) // количество по спецификации (план)
  totalUsed       Decimal        @default(0) @db.Decimal(14, 3) // фактический расход (автосчёт)
  lastEntry       Decimal?       @db.Decimal(14, 3) // последняя фиксация
  lastEntryDate   DateTime?      // дата последней фиксации
  note            String?
  progressPercent Float          @default(0)  // % выполнения (процент — не деньги/объём, остаётся Float)
  isSpecLocked    Boolean        @default(true) // защита спецификации

  // Работы (из справочника "Цены на работы")
  priceItemId     Int?
  priceItem       PriceItem?     @relation("WorkPrice", fields: [priceItemId], references: [id], onDelete: SetNull)
  unitPrice       Decimal        @default(0) @db.Decimal(14, 2) // SNAPSHOT цены работы
  totalCost       Decimal        @default(0) @db.Decimal(14, 2) // totalUsed × unitPrice (работы на тек. момент)

  // Материалы (из справочника "Цены на материалы")
  materialItemId  Int?
  materialItem    PriceItem?     @relation("MaterialPrice", fields: [materialItemId], references: [id], onDelete: SetNull)
  materialUnitPrice Decimal      @default(0) @db.Decimal(14, 2) // SNAPSHOT цены материала
  materialTotalCost Decimal      @default(0) @db.Decimal(14, 2) // totalUsed × materialUnitPrice (материалы на тек. момент)

  projectId       Int
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fixes           MaterialFix[]  // история всех фиксаций
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // ⭐ №202 (RFC импорта): откуда строка пришла — партия, номер строки файла,
  // ключ идемпотентности (повторный импорт того же файла не создаёт дубль)
  importBatchId   Int?
  importRowNumber Int?
  externalKey     String? @db.VarChar(64)

  @@unique([projectId, externalKey])
  @@index([projectId])
  @@index([projectId, importBatchId])
  @@map("materials")
}

model MaterialFix {
  id          Int       @id @default(autoincrement())
  materialId  Int
  material    Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(14, 3) // объём этой фиксации
  note        String?   // примечание к фиксации
  fixedAt     DateTime  @default(now())  // ЗА КАКОЙ день/момент работа (можно задним числом)
  createdAt   DateTime  @default(now())  // ⭐ №174: когда ВНЕСЛИ — от него 72 часа на правку
  userId      Int?      // кто зафиксировал
  isEdited    Boolean   @default(false)
  editedAt    DateTime?

  @@index([fixedAt])
  @@index([materialId, fixedAt])
  @@map("material_fixes")
}

model PriceCategory {
  id        Int           @id @default(autoincrement())
  name      String
  sortOrder Int           @default(0)
  kind      PriceKind     @default(WORK)
  items     PriceItem[]

  @@unique([name, kind])
  @@map("price_categories")
}

model PriceItem {
  id         Int           @id @default(autoincrement())
  ownerId    Int?          // null = общий стартовый справочник, userId = личный приватный (3.7)
  owner      User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  catalogId  Int           // ⭐ №151: справочник цен, в котором живёт расценка
  catalog    PriceCatalog  @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  name       String
  article    String?
  unit       Unit          @default(PIECE)
  price      Decimal       @default(0) @db.Decimal(14, 2)
  categoryId Int
  category   PriceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isActive   Boolean       @default(true)
  kind       PriceKind     @default(WORK)

  // Связи: работа или материал
  workMaterials     Material[]  @relation("WorkPrice")
  materialMaterials Material[]  @relation("MaterialPrice")
  reportItems       ReportItem[] // ⭐ Позиции в отчётах (смета/акт)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([categoryId, ownerId])
  @@index([catalogId])
  @@map("price_items")
}

// ⭐ №151: справочники цен — независимые наборы расценок под разные объекты
// (например «Квартиры/Коттеджи» с постоянной ценой и «Склад X5» со своими расценками).
model PriceCatalog {
  id         Int         @id @default(autoincrement())
  name       String
  ownerId    Int?        // null = системный (демо) справочник, доступен всем
  owner      User?       @relation("CatalogOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  isArchived Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      PriceItem[]
  projects   Project[]
  objects    Object[]    @relation("ObjectCatalog") // ⭐ №164: справочник как «объектный»

  @@index([ownerId])
  @@map("price_catalogs")
}

// ============================================================
// НОВАЯ МОДЕЛЬ ДОСТУПА И СОГЛАСОВАНИЙ (Вместо Organization)
// ============================================================

enum AccessRole {
  CUSTOMER // Заказчик — утверждает, видит всё, платит
  FOREMAN  // Прораб — добавляет/фиксирует, его изменения на согласовании
  VIEWER   // Наблюдатель — видит прогресс и количества, БЕЗ денег
}

model ObjectAccess {
  id         Int        @id @default(autoincrement())
  userId     Int
  objectId   Int
  projectId  Int?       // null = весь объект, иначе конкретный проект
  role       AccessRole @default(FOREMAN)
  hidePrices Boolean    @default(false)  // ⭐ скрывать ли цены для этого участника
  invitedBy  Int?
  // ⭐ №207: право создавать проекты в этом объекте.
  // Выдаётся администратором объекта или автоматически по одобренной заявке
  // (№178). У администратора объекта (CUSTOMER) право есть всегда.
  canCreateProjects Boolean @default(false)
  // ⚠️ №207: устарело. Раньше «прораб-менеджер» управлял командой.
  // Теперь команда — только у администратора объекта, а создание проектов
  // выдаётся через canCreateProjects. Колонка оставлена ради истории данных.
  isManager  Boolean    @default(false)
  // ⭐ №168: личный архив участника (объект скрыт только у него, остальным виден).
  isHidden   Boolean    @default(false)
  // ⭐ №168: мягкий отзыв доступа. null = доступ активен.
  // Отозванный участник видит объект «как на момент отзыва» (read-only),
  // все записи блокируются, данные остаются в его шаблонах-снимках.
  revokedAt  DateTime?
  revokedById Int?      // кто отозвал (метка, без FK — как invitedBy)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  object     Object     @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  // ⚠️ №168: обычный @@unique([userId, objectId, projectId]) не работает для NULL
  // (в Postgres NULL != NULL), поэтому уникальность держит ЧАСТИЧНЫЙ индекс
  // object_access_user_object_project_key ON (userId, objectId, COALESCE(projectId, 0)).
  // Он создаётся в миграции 20261026120000_access_ownership_freeze вручную.
  @@index([objectId])
  @@index([userId, isHidden])
  @@map("object_access")
}

// ============================================================
// ⭐ №178: ЗАЯВКИ НА ПРАВО СОЗДАВАТЬ ПРОЕКТЫ В ОБЪЕКТЕ
// ============================================================
// Зачем: участник, приглашённый ТОЛЬКО в один проект, не может создать новый
// проект в объекте (checkObjectAccess требует запись доступа с projectId = null).
// Он подаёт заявку, а администратор объекта одобряет её → появляется объектная
// запись FOREMAN + canCreateProjects (⭐ №207: раньше выдавался isManager).

enum AccessRequestStatus {
  PENDING   // ждёт решения
  APPROVED  // одобрено — право выдано
  REJECTED  // отклонено (с причиной)
  CANCELLED // заявитель отменил сам
}

enum AccessRequestKind {
  CREATE_PROJECTS // право создавать проекты в объекте (пока единственный вид)
}

model AccessRequest {
  id            Int                 @id @default(autoincrement())
  objectId      Int
  requesterId   Int
  kind          AccessRequestKind   @default(CREATE_PROJECTS)
  comment       String?
  status        AccessRequestStatus @default(PENDING)
  reviewedBy    Int?
  reviewComment String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  object    Object @relation(fields: [objectId], references: [id], onDelete: Cascade)
  requester User   @relation("AccessRequestsMade", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer  User?  @relation("AccessRequestsReviewed", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([objectId, status])
  @@index([requesterId, status])
  @@map("access_requests")
}

// ============================================================
// ⭐ №175: ШАБЛОНЫ ОБЪЕКТОВ
// ============================================================
// Отдельная сущность: снимок структуры объекта (проекты + позиции смет).
// sourceObjectId — только подпись «создан из объекта X», без FK и без каскадов:
// удаление объекта-образца шаблон не трогает.
// Публикация: автор сам делает шаблон общим; правит/удаляет автор или админ.
// Автосинхронизации нет — создание объекта из шаблона это разовая копия.

model ObjectTemplate {
  id               Int      @id @default(autoincrement())
  name             String
  note             String?
  authorId         Int
  isPublic         Boolean  @default(false)
  sourceObjectId   Int? // только метка, без relation
  sourceObjectName String? // чтобы подпись жила, даже если объект удалён
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  author   User                    @relation("ObjectTemplates", fields: [authorId], references: [id], onDelete: Cascade)
  projects ObjectTemplateProject[]

  @@index([authorId])
  @@index([isPublic])
  @@map("object_templates")
}

model ObjectTemplateProject {
  id         Int    @id @default(autoincrement())
  templateId Int
  name       String
  note       String?
  sortOrder  Int    @default(0)

  template  ObjectTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  materials ObjectTemplateMaterial[]

  @@index([templateId])
  @@map("object_template_projects")
}

model ObjectTemplateMaterial {
  id       Int     @id @default(autoincrement())
  projectId Int
  name     String
  article  String?
  unit     Unit    @default(PIECE)
  // объём по спецификации (план) — фиксации не переносим
  specQuantity Decimal @default(0) @db.Decimal(12, 3)
  note     String?
  // ссылки на расценки: при создании объекта переносим, если позиция ещё жива
  priceItemId    Int?
  materialItemId Int?
  // снимок цен на момент сохранения шаблона (не зависит от справочника)
  unitPrice         Decimal? @db.Decimal(12, 2)
  materialUnitPrice Decimal? @db.Decimal(12, 2)

  project ObjectTemplateProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("object_template_materials")
}

// ============================================================
// СНИМОК ДОСТУПА (№194, F1 шаг 2)
// Создаётся в момент отзыва вместе с копиями-шаблонами.
// Только чтение: ни один endpoint не меняет payload — это слепок «как было».
// ============================================================
// ============================================================
// ИМПОРТ СМЕТЫ ИЗ EXCEL (№202, RFC docs/RFC-import-estimate.md)
// Партия = журнал: предпросмотр хранится в preview (Json), commit пишет
// строки сметы в одной транзакции, провенанс — в Material.importBatchId.
// ============================================================
model ImportBatch {
  id              Int      @id @default(autoincrement())
  projectId       Int
  importedById    Int // метка автора (без FK: при удалении аккаунта не рушим журнал)
  fileName        String?
  fileHash        String?
  templateVersion Int?
  status          String   @default("PREVIEW") // PREVIEW|COMMITTING|COMMITTED|FAILED|CANCELLED
  rowsTotal       Int      @default(0)
  createdCount    Int      @default(0)
  updatedCount    Int      @default(0)
  skippedCount    Int      @default(0)
  pricesCreated   Int      @default(0)
  preview         Json?
  report          Json?
  createdAt       DateTime @default(now())
  committedAt     DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("import_batches")
}

model AccessSnapshot {
  id          Int      @id @default(autoincrement())
  userId      Int // кому отозвали доступ (владелец снимка)
  objectId    Int // метка без relation: снимок должен жить дольше объектов
  accessId    Int? // запись доступа, по которой снят снимок (её могут удалить)
  objectName  String
  projectId   Int? // если доступ был только к одному проекту
  projectName String?
  role        String // роль на момент отзыва (CUSTOMER/FOREMAN/VIEWER)
  hidePrices  Boolean  @default(false) // снимали снимок без денег?
  takenAt     DateTime @default(now()) // момент отзыва
  revokedBy   Int? // кто отозвал (обезличивается при удалении аккаунта)
  summary     Json // { projects, materials, reports, warehouseItems, ... }
  payload     Json // сам слепок
  user        User     @relation("AccessSnapshots", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
  @@map("access_snapshots")
}

// ============================================================
// ПРИГЛАШЕНИЯ ССЫЛКОЙ (как в Notion/Figma)
// ============================================================

model InviteToken {
  id         Int          @id @default(autoincrement())
  token      String       @unique           // URL-safe токен (nanoid)
  objectId   Int
  createdBy  Int          // кто создал ссылку (прораб или заказчик)
  role       AccessRole   @default(FOREMAN) // роль, с которой будет добавлен юзер
  hidePrices Boolean      @default(false)   // ⭐ флаг «скрыть цены» для приглашённых
  expiresAt  DateTime?    // срок жизни (null = бессрочно)
  maxUses    Int?         // макс. использований (null = без лимита)
  usesCount  Int          @default(0)       // счётчик использований
  isActive   Boolean      @default(true)    // можно отозвать ссылку
  createdAt  DateTime     @default(now())
  object     Object       @relation(fields: [objectId], references: [id], onDelete: Cascade)
  creator    User         @relation("CreatedInvites", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([objectId])
  @@map("invite_tokens")
}

// ============================================================
// ВОССТАНОВЛЕНИЕ ПАРОЛЯ (P0-4)
// ============================================================
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique              // URL-safe токен (crypto.randomBytes)
  expiresAt DateTime                     // срок действия (обычно 1 час)
  usedAt    DateTime?                    // null = не использован, дата = использован
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// АРЕНДА (личный учёт арендованного оборудования)
// ============================================================
model Rental {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String               // что за оборудование
  location    String?              // где лежит (необязательно)
  responsible String?              // кто ответственный (необязательно)
  startDate   DateTime
  endDate     DateTime
  price       Decimal              @db.Decimal(14, 2) // цена аренды при создании
  totalSpent  Decimal              @db.Decimal(14, 2) // всего потрачено (price + все продления)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("rentals")
}

// ============================================================
// СКЛАД (учёт материалов/оборудования прораба)
// ============================================================
model WarehouseItem {
  id          Int       @id @default(autoincrement())
  name        String
  unit        String    @default("шт")
  category    String?   // "инструмент", "расходник", "оборудование"
  quantity    Decimal   @default(0) @db.Decimal(12, 2)
  price       Decimal?  @db.Decimal(12, 2)
  comment     String?
  objectId    Int?      // привязка к объекту (опционально)
  object      Object?   @relation(fields: [objectId], references: [id], onDelete: SetNull)
  // ⭐ №204 (A#2): владелец «общей» позиции (objectId = null). NULL — легаси-строки
  // до миграции, они остаются общими для всех (демо-данные не ломаем).
  createdBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  transactions WarehouseTransaction[]

  @@index([objectId])
  @@index([createdBy])
  @@map("warehouse_items")
}

model WarehouseTransaction {
  id              Int            @id @default(autoincrement())
  warehouseItemId Int
  warehouseItem   WarehouseItem  @relation(fields: [warehouseItemId], references: [id], onDelete: Cascade)
  type            String         // "income" / "expense" / "write-off"
  quantity        Decimal        @db.Decimal(12, 2)
  price           Decimal?       @db.Decimal(12, 2)
  projectId       Int?           // куда списано (для expense/write-off)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comment         String?
  createdBy       Int?           // ⭐ №168: nullable — при удалении аккаунта автор обезличивается
  createdAt       DateTime       @default(now())

  @@index([warehouseItemId])
  @@index([projectId])
  @@map("warehouse_transactions")
}

// ============================================================
// ОТЧЁТЫ (сметы и акты выполненных работ)
// ============================================================
model Report {
  id          Int       @id @default(autoincrement())
  type        String    // "estimate" (смета) / "act" (акт выполненных работ)
  title       String
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  objectId    Int
  object      Object    @relation(fields: [objectId], references: [id], onDelete: Cascade)
  totalAmount Decimal   @db.Decimal(12, 2) @default(0)
  status      String    @default("draft") // "draft" / "sent" / "approved" / "rejected"
  comment     String?
  createdBy   Int?      // ⭐ №168: nullable — при удалении аккаунта автор обезличивается
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items       ReportItem[]

  @@index([projectId])
  @@index([objectId])
  @@index([status])
  @@map("reports")
}

model ReportItem {
  id         Int         @id @default(autoincrement())
  reportId   Int
  report     Report      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  materialId Int?        // ссылка на позицию справочника цен (опционально)
  material   PriceItem?  @relation(fields: [materialId], references: [id], onDelete: SetNull)
  name       String
  unit       String      @default("шт")
  quantity   Decimal     @db.Decimal(12, 2)
  price      Decimal     @db.Decimal(12, 2)
  total      Decimal     @db.Decimal(12, 2)
  sortOrder  Int         @default(0)

  @@index([reportId])
  @@map("report_items")
}

// ============================================================
// ВЕРИФИКАЦИЯ EMAIL ПРИ РЕГИСТРАЦИИ (6-значный код)
// ============================================================
model VerificationToken {
  id        Int      @id @default(autoincrement())
  email     String
  code      String   // 6-значный код
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([code])
  @@map("verification_tokens")
}

// ============================================================
// БРИГАДЫ (учёт выходов и выработки)
// ============================================================
model Brigade {
  id          Int       @id @default(autoincrement())
  name        String    // "Бригада отделочников №1"
  specialty   String?   // "отделочники", "электрики", "сантехники"
  foremanName String?   // бригадир
  phone       String?
  objectId    Int?      // привязка к объекту (опционально — мобильная бригада)
  object      Object?   @relation(fields: [objectId], references: [id], onDelete: SetNull)
  comment     String?
  // ⭐ №204 (A#2): владелец «мобильной» бригады (objectId = null). NULL — легаси-строки.
  createdBy   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  members     BrigadeMember[]
  shifts      BrigadeShift[]

  @@index([objectId])
  @@index([createdBy])
  @@map("brigades")
}

model BrigadeMember {
  id         Int       @id @default(autoincrement())
  brigadeId  Int
  brigade    Brigade   @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  fullName   String
  role       String?   // "бригадир", "мастер", "рабочий"
  phone      String?
  createdAt  DateTime  @default(now())
  shiftLogs  BrigadeShiftMember[] // ⭐ №169: отметки в выходах

  @@index([brigadeId])
  @@map("brigade_members")
}

model BrigadeShift {
  id          Int       @id @default(autoincrement())
  brigadeId   Int
  brigade     Brigade   @relation(fields: [brigadeId], references: [id], onDelete: Cascade)
  projectId   Int?      // на каком проекте работали
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  date        DateTime  @db.Date
  hoursWorked Decimal   @db.Decimal(5, 2) // 0.00 - 999.99
  outputValue Decimal?  @db.Decimal(12, 2) // выработка в ₽ (опционально)
  outputArea  Decimal?  @db.Decimal(10, 2) // выработка в м² (опционально)
  comment     String?
  createdBy   Int?      // ⭐ №168: nullable — при удалении аккаунта автор обезличивается
  createdAt   DateTime  @default(now())
  members     BrigadeShiftMember[] // ⭐ №169: кто именно выходил и по сколько часов

  @@index([brigadeId])
  @@index([projectId])
  @@index([date])
  @@map("brigade_shifts")
}

// ⭐ №169: состав одного выхода — по строке на рабочего.
// hoursWorked в BrigadeShift остаётся суммой (совместимость с отчётами и статистикой),
// а здесь хранится разрез: «кто был» + «сколько часов у каждого».
model BrigadeShiftMember {
  id        Int           @id @default(autoincrement())
  shiftId   Int
  shift     BrigadeShift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  memberId  Int?          // null — рабочего потом удалили из бригады
  member    BrigadeMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  fullName  String        // снимок ФИО на момент выхода
  hours     Decimal       @db.Decimal(5, 2)
  createdAt DateTime      @default(now())

  @@index([shiftId])
  @@index([memberId])
  @@map("brigade_shift_members")
}

// ============================================================
// ШАБЛОНЫ СМЕТ (№129) — сохранить проект как шаблон и применить
// ============================================================
model EstimateTemplate {
  id        Int                    @id @default(autoincrement())
  name      String
  ownerId   Int                    // владелец шаблона (userId)
  createdAt DateTime               @default(now())
  items     EstimateTemplateItem[]

  @@index([ownerId])
  @@map("estimate_templates")
}

model EstimateTemplateItem {
  id                Int               @id @default(autoincrement())
  templateId        Int
  template          EstimateTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name              String
  unit              Unit              @default(PIECE)
  quantity          Decimal           @db.Decimal(14, 3) // specQuantity
  unitPrice         Decimal           @db.Decimal(14, 2) // снимок цены работы
  materialUnitPrice Decimal           @db.Decimal(14, 2) // снимок цены материала
  priceItemId       Int?              // ссылка на расценку работы (опционально)
  materialItemId    Int?              // ссылка на расценку материала (опционально)
  sortOrder         Int               @default(0)

  @@index([templateId])
  @@map("estimate_template_items")
}

// ============================================================
// АУДИТ-ЛОГ (№131) — append-only журнал ключевых действий
// ============================================================
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int      // кто совершил (userId)
  entity    String   // "price_item" | "report" | "material_fix" | "object_access"
  entityId  Int
  action    String   // "create" | "update" | "delete" | "status_change" | "price_change"
  before    Json?    // снимок до (опционально)
  after     Json?    // снимок после
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}