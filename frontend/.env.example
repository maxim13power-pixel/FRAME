# ============================================================
# FRAME frontend — переменные окружения (ПЛЕЙСХОЛДЕРЫ!)
# Скопируй в frontend/.env. Vite читает .env ТОЛЬКО при старте —
# после изменения нужно перезапустить `npm run dev`/`npm run build`.
# НИКОГДА не коммить frontend/.env — он в .gitignore.
# ============================================================

# --- API бэкенда ---
# Основной URL бэкенда (читается в src/config.ts → API_BASE_URL).
# В dev — http://localhost:3000, в проде — URL бэкенда на Railway.
VITE_API_BASE_URL=http://localhost:3000

# --- Переопределение API (ОПЦИОНАЛЬНО) ---
# Имеет ПРИОРИТЕТ над VITE_API_BASE_URL (читается в src/services/api.ts).
# Пустое значение = использовать VITE_API_BASE_URL. Обычно не заполняй.
VITE_API_URL=

# --- Публичный URL фронта ---
# Используется для генерации ссылок-приглашений (Universal/Deep Links).
VITE_APP_URL=http://localhost:5000

# --- Yandex SmartCaptcha ---
# Клиентский (site) ключ капчи для виджета на странице регистрации.
VITE_SMARTCAPTCHA_CLIENT_KEY=your-smartcaptcha-client-key
