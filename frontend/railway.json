{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --no-audit --no-fund && npm run build"
  },
  "deploy": {
    "startCommand": "serve -s dist -l tcp://0.0.0.0:${PORT:-3000}",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE"
  }
}
